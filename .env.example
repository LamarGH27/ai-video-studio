# =============================================================================
# AI Video Studio — environment variables
# =============================================================================
# Copy to .env.local and fill in from your Supabase project.
# NEVER commit .env.local or paste a real key into this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Public — inlined into the browser bundle (NEXT_PUBLIC_ prefix)
# -----------------------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase PUBLISHABLE key (Project Settings -> API Keys).
#
# On a current project this looks like `sb_publishable_...`. On an older project
# that has not migrated yet, the equivalent is the key labelled `anon` `public`
# (a long JWT beginning `eyJ...`). Either value goes here and behaves the same:
# both are designed to be public, and every request made with one is still
# constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin of this deployment, used to build auth redirect URLs.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Secret keys
# -----------------------------------------------------------------------------
# There are none, by design.
#
# This application never uses a Supabase secret key (`sb_secret_...`, formerly
# the `service_role` key). Nothing in it needs to bypass Row Level Security:
# customer requests run as the customer, and admin requests run as the admin,
# so RLS applies to every query the application makes.
#
# If a future milestone genuinely needs one — a scheduled job or a webhook with
# no user session — add it as a SERVER-ONLY variable (never NEXT_PUBLIC_) and
# read it from a single `server-only` module. See docs/architecture.md §11.

# -----------------------------------------------------------------------------
# End-to-end tests (local / CI only, never production)
# -----------------------------------------------------------------------------
# Credentials for the three seeded test principals. When these are set, the
# authenticated Playwright specs and scripts/verify-live.ts run against a real
# Supabase project. When absent, those specs skip with a printed reason.
# Use throwaway accounts on a non-production project — never personal logins.
E2E_CUSTOMER_A_EMAIL=
E2E_CUSTOMER_A_PASSWORD=
E2E_CUSTOMER_B_EMAIL=
E2E_CUSTOMER_B_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
