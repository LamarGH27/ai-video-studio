# =============================================================================
# AI Video Studio — environment variables
# =============================================================================
# Copy to .env.local and fill in with values from your Supabase project.
# NEVER commit .env.local or paste real keys into this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Public — safe to expose to the browser (NEXT_PUBLIC_ prefix)
# -----------------------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key. This key is designed to be public; every
# request it makes is still constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of this deployment, used to build auth redirect URLs.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only — MUST NEVER be prefixed with NEXT_PUBLIC_
# -----------------------------------------------------------------------------
# Supabase service-role (secret) key. Bypasses Row Level Security entirely.
# Optional for the MVP: no current code path requires it. It exists as the
# documented extension point for future back-office jobs. If you set it, set it
# only as a server-side secret in Vercel — never in a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# End-to-end tests (optional, local/CI only)
# -----------------------------------------------------------------------------
# When these are set, the authenticated Playwright specs run against a real
# Supabase project. When they are absent, those specs are skipped with a reason
# and only the public-surface specs run. See docs/architecture.md.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
